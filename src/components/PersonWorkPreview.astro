---
import Arrow from './Arrow.astro';
import { withBase } from '../lib/urls';

interface Props {
  personId: string;
  personName: string;
  kind: 'projects' | 'publications';
  items: { title: string; href: string; year?: number }[];
}
const { personId, personName, kind, items } = Astro.props;
const title = kind === 'projects' ? 'Projects' : 'Publications';
const preview = items.slice(0, 5);
---
{items.length > 0 && <details class="group/work border-t border-line" data-work={kind}>
  <summary class="flex min-h-14 list-none items-center justify-between gap-3 py-4 text-sm font-semibold" aria-label={`${title} by ${personName} (${items.length})`}>
    <span>{title} <span class="ml-2 font-normal tabular-nums text-muted">{items.length}</span></span>
    <span class="text-xl font-normal text-accent transition-transform group-open/work:rotate-45" aria-hidden="true">+</span>
  </summary>
  <div class="pb-5">
    <ul class="space-y-3 text-sm leading-relaxed">{preview.map((item) => <li><a class="underline decoration-line underline-offset-4 hover:text-accent" href={withBase(item.href)}>{item.title}</a>{item.year && <span class="text-muted"> · {item.year}</span>}</li>)}</ul>
    {items.length > preview.length && <a class="text-link mt-5" href={withBase(`/people/${personId}/#${kind}`)}>View all {items.length} {kind} <Arrow class="size-4" /></a>}
  </div>
</details>}
