---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import EmptyState from '../../components/EmptyState.astro';
import { withBase } from '../../lib/urls';
import { publishedNews, formatDate } from '../../lib/news';
const posts = await publishedNews();
---
<Layout title="Notes from the group." eyebrow="04 / News & updates" intro="New work, shared ideas, and moments along the way.">
  {posts.length > 0 ? <div class="border-b border-line">
    {posts.map((post) => <article class="grid gap-5 border-t border-line py-9 sm:grid-cols-[160px_1fr] lg:grid-cols-[220px_1fr] lg:py-12">
      <time class="text-sm text-muted" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <div><h2 class="max-w-3xl text-3xl leading-tight font-medium tracking-[-0.045em]"><a class="transition-colors hover:text-accent" href={withBase(`/news/${post.id}/`)}>{post.data.title}</a></h2><p class="mt-4 max-w-2xl text-base leading-[1.8] text-muted">{post.data.description}</p><a class="text-link mt-6" href={withBase(`/news/${post.id}/`)}>Read update <Arrow class="size-4" /></a></div>
    </article>)}
  </div> : <EmptyState title="No updates published yet." description="News and announcements from the group will appear here." />}
</Layout>
