---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EmptyState from '../components/EmptyState.astro';
import PersonPortrait from '../components/PersonPortrait.astro';
import PersonWorkPreview from '../components/PersonWorkPreview.astro';
import { catalog } from '../lib/catalog';
import { withBase } from '../lib/urls';
const { people } = catalog;
---
<Layout title="People & perspectives." eyebrow="02 / The group" intro="Meet the people behind the questions, the ideas, and the work.">
  <div class="mb-8 flex items-center justify-between border-b border-line pb-5"><h2 class="eyebrow text-muted">Our people</h2><span class="text-sm tabular-nums text-muted">{String(people.length).padStart(2, '0')} {people.length === 1 ? 'person' : 'people'}</span></div>
  {people.length > 0 ? <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    {people.map((person) => (
      <article id={person.personId} class="min-w-0 scroll-mt-28">
        <PersonPortrait person={person} />
        <p class="eyebrow mt-6 mb-3 text-accent">{person.role}</p>
        <h3 class="text-2xl font-medium tracking-[-0.035em]"><a class="hover:text-accent" href={withBase(`/people/${person.personId}/`)}>{person.name}</a></h3>
        {person.position && <p class="mt-2 text-sm text-muted">{person.position}</p>}
        <p class="mt-3 max-w-sm text-sm leading-[1.85] text-muted">{person.bio}</p>
        {person.email && <a class="mt-3 block w-fit text-sm break-all underline decoration-line underline-offset-4 hover:text-accent" href={`mailto:${person.email}`}>{person.email}</a>}
        <a class="text-link mt-5" href={withBase(`/people/${person.personId}/`)}>View profile <Arrow class="size-4" /></a>
        <div class="mt-6">
          <PersonWorkPreview personId={person.personId} personName={person.name} kind="projects" items={person.projects.map((project) => ({ title: project.title, href: `/projects/#${project.projectId}` }))} />
          <PersonWorkPreview personId={person.personId} personName={person.name} kind="publications" items={person.publications.map((publication) => ({ title: publication.title, href: `/publications/#${publication.publicationId}`, year: publication.year }))} />
        </div>
      </article>
    ))}
  </div> : <EmptyState title="Meet the group, soon." description="Member profiles will be published here as they become available." />}
</Layout>
